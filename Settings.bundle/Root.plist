<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>StringsTable</key><string>Root</string>
  <key>PreferenceSpecifiers</key><array>
    <dict>
      <key>Type</key><string>PSGroupSpecifier</string>
      <key>Title</key><string>Stremio</string>
      <key>FooterText</key><string>The Stremio web app to load. Leave as web.stremio.com, or enter your own self-hosted instance. Relaunch the app after changing.</string>
    </dict>
    <dict>
      <key>Type</key><string>PSTextFieldSpecifier</string>
      <key>Title</key><string>Web URL</string>
      <key>Key</key><string>stremioWebURL</string>
      <key>DefaultValue</key><string>https://web.stremio.com</string>
      <key>KeyboardType</key><string>URL</string>
      <key>AutocapitalizationType</key><string>None</string>
      <key>AutocorrectionType</key><string>No</string>
    </dict>
    <dict>
      <key>Type</key><string>PSToggleSwitchSpecifier</string>
      <key>Title</key><string>Show setup on next launch</string>
      <key>Key</key><string>showSetupNextLaunch</string>
      <key>DefaultValue</key><false/>
    </dict>
  </array>
</dict></plist>
